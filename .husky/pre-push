#!/bin/sh
EXPECTED_VERSION=$(grep '"packageManager"' package.json | sed 's/.*"bun@\([^"]*\)".*/\1/')
CURRENT_VERSION=$(./node_modules/.bin/bun --version)
if [ "$CURRENT_VERSION" != "$EXPECTED_VERSION" ]; then
  echo "Error: Bun version $CURRENT_VERSION does not match expected $EXPECTED_VERSION"
  exit 1
fi
./node_modules/.bin/bun typecheck
